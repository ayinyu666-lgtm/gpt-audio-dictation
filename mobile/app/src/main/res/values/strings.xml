    <!-- Recording settings -->
    <string name="label_max_seconds">每条消息最长秒数</string>
    <string name="desc_max_seconds">到达该秒数会立即发送；越接近该时长，停顿越容易触发发送。设为较短值时会话节奏接近普通聊天。</string>
    <string name="hint_max_seconds_range">5–1800 秒</string>
    <string name="label_pause_bias">停顿激进程度</string>
    <string name="desc_pause_bias">偏灵敏会提前进入“寻找停顿”的区间；偏保守则更晚才愿意因停顿发送。</string>
    <string name="label_noise_ignore">噪音忽略</string>
    <string name="desc_noise_ignore">决定多大的画面起伏才算「有人在说话」。左侧更灵敏，右侧更保守。默认「自动」与旧版行为一致，最长时长兜底始终有效。</string>
    <string name="hint_settings_live">修改会保存，并在下一次开始时生效。噪音忽略的调整在无障碍服务重新连接后生效。</string>
    <string name="value_seconds">%1$d 秒</string>    <string name="value_bias_standard">标准 0</string>
    <string name="value_bias_conservative">保守 %1$d</string>
    <string name="value_bias_sensitive">灵敏 +%1$d</string>
    <string name="value_noise_auto">自动 0</string>
    <string name="value_noise_less">少忽略 %1$d</string>
    <string name="value_noise_more">多忽略 +%1$d</string>
    <string name="content_desc_slider_range">范围 %1$d 到 %2$d</string>

    <!-- Advanced -->
    <string name="label_mic_probe">麦克风测试</string>
    <string name="desc_mic_probe">手动测一次本应用能否收到声音，测完立即释放麦克风。它只反映本应用自己，不证明 ChatGPT 同时在录音。</string>
    <string name="btn_probe">测一次麦克风</string>
    <string name="probe_running">正在测试麦克风…</string>
    <string name="probe_permission_denied">未授予麦克风权限；不影响波形方式</string>
    <string name="label_diagnostics">测试诊断</string>
    <string name="desc_diagnostics">记录界面结构与文本哈希（只存哈希，不存原文），用于排查。下一次开始生效，仅 debug 版可见。</string>
    <string name="label_diag_status">诊断状态</string>

