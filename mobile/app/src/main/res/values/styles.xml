<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the platform theme is used (no AppCompat, no Material). Names are flat
      (GadXxx) on purpose: dotted style names create implicit parent chains that make
      the generated R fields ambiguous.
    -->
    <style name="GadAppTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gad_text_primary</item>
    </style>

    <style name="GadSubtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gad_text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="GadSectionTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gad_text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="GadCard">
        <item name="android:background">@drawable/gad_bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="GadItemTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/gad_text_primary</item>
    </style>

    <style name="GadItemDesc">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gad_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:paddingTop">2dp</item>
    </style>

    <style name="GadValue">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gad_accent</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="GadStatusMessage">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gad_text_primary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="GadChip">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="GadButton">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:background">@drawable/gad_bg_button</item>
        <item name="android:textColor">@color/gad_text_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="GadButtonPrimary">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:background">@drawable/gad_bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="GadButtonLink">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/gad_accent</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="GadLinkRow">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/gad_text_primary</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="GadRowLink">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="GadFooter">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/gad_text_hint</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <style name="GadPreset">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gad_text_primary</item>
        <item name="android:background">@drawable/gad_bg_pill_outline</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
